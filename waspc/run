#!/usr/bin/env bash

# This script defines common commands used during building / developing `waspc` project
# and makes it easy to run them. The commands are mise tasks, see `mise tasks`.

WASPC_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# `-C` lets this work outside the repo, and WASP_CALLER_DIR keeps the caller's
# directory for tasks that run in it.
WASP_CALLER_DIR=$PWD exec mise -C "$WASPC_DIR" run "$@"
