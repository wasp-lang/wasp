{
  "dependencies": {
    "@wasp.sh/lib-auth": "file:../libs/auth/wasp.sh-lib-auth-0.26.0.tgz",
    "cookie-parser": "~1.4.6",
    "cors": "^2.8.5",
    "express": "~5.1.0",
    "helmet": "^6.0.0",
    "morgan": "~1.11.0",
    "nitro": "3.0.260610-beta",
    "superjson": "^2.2.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "latest",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "6.0.3"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=24.14.1"
  },
  "name": "@wasp.sh/generated-server",
  "prisma": {
    "seed": "npm run db-seed"
  },
  "private": true,
  "scripts": {
    "db-migrate-prod": "prisma migrate deploy --schema=../db/schema.prisma",
    "db-seed": "vite build --config dbSeed.vite.config.js && node --enable-source-maps --env-file-if-exists=.env dist/dbSeed.js",
    "start-production": "npm run db-migrate-prod && NODE_ENV=production NITRO_PORT=${PORT:-3001} node --enable-source-maps --env-file-if-exists=.env ../web-app/server/index.mjs"
  },
  "type": "module",
  "version": "0.0.0"
}
