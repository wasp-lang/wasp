{
  "comment-filip": "The server.js location changed because we have now included client source files above .wasp/out/server/src.",
  "dependencies": {
    "@socket.io/component-emitter": "^4.0.0",
    "@wasp/lib-auth": "file:../libs/auth/wasp-lib-auth-0.27.0.tgz",
    "@wasp/lib-sdk-core": "file:../libs/sdk-core/wasp-lib-sdk-core-0.27.0.tgz",
    "@wasp/lib-test-utils": "file:../libs/test-utils/wasp-lib-test-utils-0.27.0.tgz",
    "@wasp/lib-vite-ssr": "file:../libs/vite-ssr/wasp-lib-vite-ssr-0.27.0.tgz",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "latest",
    "@types/node": "^24.0.0"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=24.22.1"
  },
  "name": "@wasp/generated-server",
  "nodemonConfig": {
    "delay": "1000"
  },
  "private": true,
  "scripts": {
    "bundle": "tsc --build && rollup --config --silent",
    "bundle-and-start": "npm run bundle && npm run start",
    "bundle-db-seed": "tsc --build && rollup --config rollup.dbSeed.config.js --silent",
    "db-migrate-prod": "prisma migrate deploy --schema=../db/schema.prisma",
    "db-seed": "npm run bundle-db-seed && node --enable-source-maps -r dotenv/config bundle/dbSeed.js",
    "start": "node --enable-source-maps -r dotenv/config bundle/server.js",
    "start-production": "npm run db-migrate-prod && NODE_ENV=production npm run start",
    "watch": "nodemon --exec 'npm run bundle-and-start || exit 1'"
  },
  "type": "module",
  "version": "0.0.0"
}
