{
  "comment-filip": "The server entrypoint is emitted as build/bootstrap.js.",
  "dependencies": {
    "@wasp.sh/lib-auth": "file:../libs/auth/wasp.sh-lib-auth-0.26.0.tgz",
    "@wasp.sh/lib-vite-ssr": "file:../libs/vite-ssr/wasp.sh-lib-vite-ssr-0.26.0.tgz",
    "cookie-parser": "~1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "~5.1.0",
    "helmet": "^6.0.0",
    "morgan": "~1.11.0",
    "superjson": "^2.2.1",
    "wasp": "file:../sdk/wasp"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@tsconfig/node24": "latest",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.0.0",
    "@types/node": "^24.0.0",
    "nodemon": "^2.0.19",
    "rollup": "^4.9.6",
    "rollup-plugin-esbuild": "^6.1.1",
    "typescript": "6.0.3"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=24.14.1"
  },
  "name": "@wasp.sh/generated-server",
  "nodemonConfig": {
    "delay": "1000"
  },
  "prisma": {},
  "private": true,
  "scripts": {
    "build": "tsc --build && rollup --config --silent",
    "build-and-start": "npm run build && npm run start",
    "db-migrate-prod": "prisma migrate deploy --schema=../db/schema.prisma",
    "seed": "npm run build && node --enable-source-maps -r dotenv/config build/seed/bootstrap.js",
    "start": "node --enable-source-maps -r dotenv/config build/bootstrap.js",
    "start-production": "npm run db-migrate-prod && NODE_ENV=production npm run start",
    "watch": "nodemon --exec 'npm run build-and-start || exit 1'"
  },
  "type": "module",
  "version": "0.0.0"
}
