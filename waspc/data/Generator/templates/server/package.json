{{={= =}=}}
{
  "name": "{= packageName =}",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "comment-filip": "The server entrypoint is emitted as build/bootstrap.js.",
  "scripts": {
    "build": "tsc --build && rollup --config --silent",
    "start": "node --enable-source-maps -r dotenv/config build/bootstrap.js",
    "build-and-start": "npm run build && npm run start",
    "watch": "nodemon --exec 'npm run build-and-start || exit 1'",
    "seed": "npm run build && node --enable-source-maps -r dotenv/config build/seed/bootstrap.js",
    "db-migrate-prod": "prisma migrate deploy --schema=../db/schema.prisma",
    "start-production": "{=& startProductionScript =}"
  },
  "nodemonConfig": {
    "delay": "1000"
  },
  "engineStrict": true,
  "engines": {
    "node": "{=& nodeVersionRange =}"
  },
  "prisma": {=& prisma =},
  {=& depsChunk =},
  {=& devDepsChunk =}
}
