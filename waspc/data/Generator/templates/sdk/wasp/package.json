{{={= =}=}}
{
  "name": "{= sdkPackageName =}",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node ./scripts/copy-assets.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "types": "tsc --declaration --emitDeclarationOnly --stripInternal --declarationDir dist"
  },
  {=!
    IMPORTANT: If you modify this list, remember to update the spreadsheet at:
    https://docs.google.com/spreadsheets/d/1QW-_16KRGTOaKXx9NYUtjk6m2TQ0nUMOA74hBthTH3g/edit
  =}
  {=!
    TYPE PORTABILITY CONSTRAINT:
    Any type that can appear in a user's inferred exported types must be
    declared in a module reachable through this exports map. Some exports
    below exist only to satisfy this, so don't remove an export just
    because nothing imports it directly.

    Why?
    Server's and client's TypeScript project files reference the user's
    TypeScript project through project references. This forces the user's
    tsconfig to set `composite: true` flag which automatically implies
    `declaration: true`.
    
    When declaration emit is enabled, every exported binding without an
    explicit type annotation gets its inferred type serialized into a
    `.d.ts` file. A common example is users defining operations while
    typing them with the `satisfies` keyword:

    ```ts
    import type { GetNumberOfTasks } from "wasp/server/operations";

    export const getNumberOfTasks = (async (_args, context) => {
      return context.entities.Task.count();
    }) satisfies GetNumberOfTasks<void>;
    ```

    If that inferred type structurally contains a type symbol from this
    package, `tsc` must synthesize a portable reference to that symbol.
    E.g., an authenticated operation's context contains a type symbol
    for `AuthUser`. So we must be able to create a portable reference
    to `AuthUser`.

    Because `AuthUser` is declared in an exports-reachable module
    ("./auth/user"), `tsc` can always create a portable reference to it,
    no matter what the user's code imports. If it were declared in a
    non-exported module (e.g. `wasp/server/auth/user`), `tsc` could name
    it only when the user's program happened to load some module
    re-exporting it, which is not guaranteed, and declaration emit
    would fail.
  =}
  "exports": {
    {=!
      ===============================================================
      Public API for users. Documented.
      These are the modules that users import in their own code.
      Some of the modules are also imported by the generated server project.
      Those have additioanl comments saying which exports user/server uses.
      ===============================================================
    =}
    "./auth": "./dist/auth/index.js",
    {=! FIXME: Documented only in example apps, not in docs. Also re-exported through `wasp/server/auth`.=}
    {=! FIXME: Candidate for removal? =}
    {=! Users: validators in custom auth actions. =}
    {=! Server: the same validators in auth provider routes. =}
    "./auth/validation": "./dist/auth/validation.js",
    "./client": "./dist/client/index.js",
    "./client/api": "./dist/api/index.js",
    "./client/auth": "./dist/client/auth/index.js",
    "./client/crud": "./dist/client/crud/index.js",
    {=! Users: operation functions and hooks.  =}
    {=! Client: initializeQueryClient in the app entry. =}
    "./client/operations": "./dist/client/operations/index.js",
    "./client/router": "./dist/client/router/index.js",
    "./client/test": "./dist/client/test/index.js",
    "./client/vite": "./dist/client/vite/index.js",
    "./client/webSocket": "./dist/client/webSocket/index.js",
    {=! Users: entity types. =}
    {=! Server: the auth entity type. =}
    "./entities": "./dist/entities/index.js",
    "./env": "./dist/env/index.js",
    {=! FIXME: Documented only in example apps, not in docs. =}
    "./serialization": "./dist/serialization/index.js",
    {=! Users: config, prisma, env, HttpError, type ServerSetupFn, type DbSeedFn, type MiddlewareConfigFn. =}
    {=! Server: config, prisma, env, HttpError, ServerSetupFn, DbSeedFn. =}
    "./server": "./dist/server/index.js",
    "./server/api": "./dist/server/api/index.js",
    {=! Users: signup field helpers and validators.  =}
    {=! Server: OAuth provider definitions, tokenStore, OAuthData. =}
    "./server/auth": "./dist/server/auth/index.js",
    "./server/crud": "./dist/server/crud/index.js",
    "./server/email": "./dist/server/email/index.js",
    "./server/jobs": "./dist/server/jobs/index.js",
    "./server/operations": "./dist/server/operations/index.js",
    {=! Users: type WebSocketDefinition, type WaspSocketData. =}
    {=! Server: type ServerType. =}
    "./server/webSocket": "./dist/server/webSocket/index.js",

    {=!
      ===============================================================
      Internal runtime agnostic API. Undocumented.
      ===============================================================
    =}
    "./auth/user": "./dist/auth/user.js",
    "./core/serialization": "./dist/core/serialization/index.js",
    "./auth/providers": "./dist/auth/providers/index.js",
    "./auth/providers/types": "./dist/auth/providers/types.js",
    "./types": "./dist/types/index.js",

    {=!
      ===============================================================
      Internal server runtime API. Undocumented.
      ===============================================================
    =}
    "./server/auth/email": "./dist/server/auth/email/index.js",
    "./server/auth/email/utils": "./dist/server/auth/email/utils.js",
    "./server/auth/jwt": "./dist/server/auth/jwt.js",
    "./server/auth/password": "./dist/server/auth/password.js",
    "./server/auth/session": "./dist/server/auth/session.js",
    "./server/auth/utils": "./dist/server/auth/utils.js",
    "./server/core/auth": "./dist/server/core/auth.js",
    "./server/crud/*": "./dist/server/crud/*.js",
    "./server/email/core/types": "./dist/server/email/core/types.js",
    "./server/jobs/*": "./dist/server/jobs/*.js",
    {=! Todo(filip): This export becomes problematic once we start supporting different executors =}
    "./server/jobs/core/pgBoss": "./dist/server/jobs/core/pgBoss/index.js",
    {=! FIXME: Reconsider during refactoring whether this is still needed. =}
    "./server/middleware": "./dist/server/middleware/index.js",
    {=! FIXME: Reconsider during refactoring whether this is still needed. =}
    "./server/types": "./dist/server/types/index.js",
    "./server/utils": "./dist/server/utils.js",

    {=!
      ===============================================================
      Internal client runtime API. Undocumented.
      Client is hidden in Wasp's vite plugin virtual modules.
      ===============================================================
    =}
    "./client/app": "./dist/client/app/index.jsx",
    "./client/app/layout": "./dist/client/app/layout.jsx",
    "./client/app/router": "./dist/client/app/router.jsx",
    {=! Injected as a vitest setupFiles entry by the vite plugin. =}
    "./client/test/setup": "./dist/client/test/setup.js"
  },
  {=!
    TypeScript doesn't care about the redirects we define above in "exports" field; those
    are used only in runtime. TypeScript instead follows exact path as stated in an import when
    trying to find the type declarations. Therefore, when "exports" redirect doesn't match the path
    it redirects to, we need to also let TypeScript know about it, and that can be done with
    `typesVersions` field below.
  =}
  "typesVersions": {
    "*": {
      "client/api": ["api/index.ts"]
    }
  },
  "license": "ISC",
  {=& depsChunk =},
  {=& devDepsChunk =},
  {=& peerDepsChunk =}
}
