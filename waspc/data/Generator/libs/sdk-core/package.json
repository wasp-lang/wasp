{
  "name": "@wasp.sh/lib-sdk-core",
  "version": "0.26.0",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "npm run build",
    "test": "npm run test:types && npm run test:type-exports",
    "test:type-exports": "attw -P --profile esm-only",
    "test:types": "tsc --noEmit"
  },
  "peerDependencies": {
    "superjson": "^2.2.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^22.17.1",
    "superjson": "^2.2.1",
    "tsdown": "^0.21.5",
    "typescript": "^6.0.3"
  }
}
