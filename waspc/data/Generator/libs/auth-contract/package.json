{
  "name": "@wasp.sh/auth-contract",
  "version": "0.26.0",
  "type": "module",
  "description": "The contract between Wasp and pluggable auth providers. Implement it to make any auth solution a Wasp auth provider.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasp-lang/wasp.git",
    "directory": "waspc/data/Generator/libs/auth-contract"
  },
  "homepage": "https://wasp.sh/",
  "bugs": {
    "url": "https://github.com/wasp-lang/wasp/issues"
  },
  "author": {
    "name": "Wasp, Inc.",
    "url": "https://wasp.sh"
  },
  "license": "MIT",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepare": "npm run build",
    "test": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "~22.12",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "tsdown": "^0.21.5",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
