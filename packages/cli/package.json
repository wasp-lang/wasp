{
  "name": "@wasp/cli",
  "version": "0.27.0",
  "type": "module",
  "description": "The Wasp CLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasp-lang/wasp.git"
  },
  "homepage": "https://wasp.sh/",
  "bugs": {
    "url": "https://github.com/wasp-lang/wasp/issues"
  },
  "author": {
    "name": "Wasp, Inc.",
    "url": "https://wasp.sh"
  },
  "funding": "https://github.com/wasp-lang/wasp?sponsor=1",
  "license": "MIT",
  "engines": {
    "node": ">=26.13.1"
  },
  "bin": {
    "wasp": "dist/bin.js"
  },
  "imports": {
    "#/package.json": "./package.json",
    "#/data.json": "./data.json",
    "#/run-wasp-cli": "./dist/run-wasp-cli.js"
  },
  "exports": {
    "./internal/run-wasp-cli": "./dist/run-wasp-cli.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run remove:dist && tsc",
    "remove:dist": "node -e \"require('fs').rmSync('./dist', { recursive: true, force: true });\"",
    "test": "vitest run"
  },
  "dependencies": {
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "//": [
    "Other Wasp CLI versions hand over to this one through the `./internal/run-wasp-cli` and `./package.json` exports (see src/installed-wasp-cli.ts and src/find-project-wasp-cli.ts), so renaming or removing them breaks the hand-over."
  ]
}
