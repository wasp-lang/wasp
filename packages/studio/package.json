{
  "name": "@wasp/studio",
  "version": "0.27.0",
  "type": "module",
  "description": "The Wasp Studio server, which `wasp studio` runs. Comes with `@wasp/wasp`.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasp-lang/wasp.git",
    "directory": "packages/studio"
  },
  "homepage": "https://wasp.sh/",
  "bugs": {
    "url": "https://github.com/wasp-lang/wasp/issues"
  },
  "author": {
    "name": "Wasp, Inc.",
    "url": "https://wasp.sh"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:client && pnpm run remove:dist && tsc && pnpm run copy:public",
    "build:client": "pnpm --dir ./client run copy",
    "copy:public": "node -e \"require('fs').cpSync('./public', './dist/public', { recursive: true });\"",
    "dev": "tsx --watch ./src/index.ts",
    "remove:dist": "node -e \"require('fs').rmSync('./dist', { recursive: true, force: true });\"",
    "start": "node ./dist/index.js"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "morgan": "^1.12.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.17.0",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
