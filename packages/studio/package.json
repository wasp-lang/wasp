{
  "name": "@wasp/studio",
  "version": "0.27.0",
  "type": "module",
  "description": "The Wasp Studio server, which `wasp studio` runs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasp-lang/wasp.git",
    "directory": "packages/studio"
  },
  "homepage": "https://wasp.sh/",
  "bugs": {
    "url": "https://github.com/wasp-lang/wasp/issues"
  },
  "author": {
    "name": "Wasp, Inc.",
    "url": "https://wasp.sh"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run remove:dist && tsc && vite build --config src/client/vite.config.ts",
    "dev:client": "vite build --watch --config src/client/vite.config.ts",
    "dev:server": "tsx --watch ./src/index.ts",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "remove:dist": "node -e \"require('fs').rmSync('./dist', { recursive: true, force: true });\"",
    "start": "node ./dist/index.js"
  },
  "dependencies": {
    "devframe": "^1.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@xyflow/react": "^12.12.1",
    "elkjs": "^0.12.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
