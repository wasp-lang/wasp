{
  "name": "@wasp/lib-auth",
  "version": "0.27.0",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "vitest dev",
    "prepare": "pnpm run build",
    "test": "pnpm run test:types && pnpm run test:coverage && pnpm run test:type-exports",
    "test:coverage": "vitest run --coverage",
    "test:type-exports": "attw -P --profile esm-only",
    "test:types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.2.1"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "oslo": "^1.1.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "catalog:",
    "@types/react": "^19.2.7",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "^0.21.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
