{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // We must set the `baseUrl`, because otherwise Docusaurus's
    // tsconfig `baseUrl` overrides ours, leading to wrong paths.
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    // Lets TypeDoc plugins, which Node.js runs directly, import TS files.
    "allowImportingTsExtensions": true
  },
  "exclude": ["build"]
}
