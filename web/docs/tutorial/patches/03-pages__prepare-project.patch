diff --git a/src/Main.css b/src/Main.css
index 4ef35f7..8bd28bf 100644
--- a/src/Main.css
+++ b/src/Main.css
@@ -107,3 +107,74 @@ code {
 .button:hover {
   background: var(--yellow-dark);
 }
+
+input {
+  border-style: solid;
+}
+
+input[type="checkbox"] {
+  width: 1.25rem;
+  height: 1.25rem;
+  margin: 0;
+  accent-color: var(--yellow);
+}
+
+button,
+input[type="submit"] {
+  padding: 0.75rem 1.25rem;
+  border: var(--border);
+  background: var(--yellow);
+  color: var(--black);
+  font: inherit;
+  font-weight: 700;
+  cursor: pointer;
+}
+
+button:hover,
+input[type="submit"]:hover {
+  background: var(--yellow-dark);
+}
+
+header button {
+  padding: 0.5rem 1rem;
+}
+
+.new-task-form {
+  display: flex;
+  gap: 0.5rem;
+}
+
+.new-task-form input[type="text"] {
+  flex: 1;
+  min-width: 0;
+  padding: 0.75rem 1rem;
+  border: var(--border);
+  background: var(--white);
+  font: inherit;
+}
+
+.tasks {
+  margin: 0;
+  padding: 0;
+  border: var(--border);
+  background: var(--white);
+  box-shadow: 6px 6px 0 var(--yellow);
+  list-style: none;
+}
+
+.tasks li + li {
+  border-top: var(--border);
+}
+
+.tasks label {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  padding: 0.75rem 1rem;
+  cursor: pointer;
+}
+
+.tasks label:has(input:checked) {
+  opacity: 0.6;
+  text-decoration: line-through;
+}
