{
  "$schema": "https://typedoc.org/schema.json",

  // Document the package as the `wasp` package that Wasp apps import.
  "name": "wasp",

  "readme": "none",
  "disableSources": true,
  "excludeInternal": true,

  // Don't document types from `node_modules` (e.g., React Query's or the
  // built-in TypeScript ones), only the `@wasp/lib-sdk-core` ones, which
  // `typedoc-plugin-missing-exports` pulls in.
  "excludeExternals": true,

  // Document the types that `typedoc-plugin-missing-exports` pulls in next to
  // the exports that reference them, instead of in a separate `<internal>`
  // module.
  "placeInternalsInOwningModule": true,

  // One module per SDK import path, e.g. `server.d.ts` documents `wasp/server`.
  "entryPoints": ["./**/*.d.ts"],
  "exclude": ["node_modules/**"],
}
