{
  "name": "@wasp.sh/kitchen-sink-example-module",
  "version": "0.0.3",
  "type": "module",
  "description": "Experimental example full-stack module for Wasp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasp-lang/wasp.git",
    "directory": "examples/wasp.sh-kitchen-sink-example-module"
  },
  "homepage": "https://github.com/wasp-lang/wasp/tree/main/examples/wasp.sh-kitchen-sink-example-module#readme",
  "license": "MIT",
  "exports": {
    "./spec": {
      "types": "./dist/spec.d.ts",
      "import": "./dist/spec.js",
      "default": "./dist/spec.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "wasp module build",
    "pack": "npm pack --pack-destination .",
    "typecheck": "tsc -p tsconfig.wasp.json && tsc -p tsconfig.src.json"
  },
  "peerDependencies": {
    "@wasp.sh/spec": "^0.25.0",
    "react": "^19.2.1",
    "wasp": "*"
  },
  "dependencies": {
    "quote-lib": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/react": "^19.2.7",
    "@wasp.sh/spec": "file:.wasp/spec/",
    "react": "^19.2.1",
    "typescript": "6.0.3",
    "wasp": "file:.wasp/wasp"
  },
  "publishConfig": {
    "access": "public"
  },
  "wasp": {
    "module": {}
  }
}
