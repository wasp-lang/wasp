{
  "name": "todo-app-ts",
  "type": "module",
  "workspaces": [
    ".wasp/out/*",
    ".wasp/out/sdk/wasp"
  ],
  "scripts": {
    "build": "wasp build",
    "dev": "wasp start",
    "preview": "wasp build start",
    "test": "npm run test:install-deps && DEBUG=pw:webserver playwright test --config e2e-tests/",
    "test:install-deps": "playwright install ${WASP_PLAYWRIGHT_INSTALL_FLAGS---with-deps}",
    "wasp": "wasp"
  },
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^8.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@wasp/spec": "file:.wasp/spec",
    "@wasp/wasp-app-runner": "^0.0.19",
    "prisma": "6.19.3",
    "typescript": "6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
