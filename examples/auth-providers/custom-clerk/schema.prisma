datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Identical in all three example apps. Nothing here mentions an auth provider:
// the provider vouches for a request, Wasp resolves that to a row in THIS table.
model User {
  id    String @id @default(uuid())
  tasks Task[]
}

model Task {
  id          String  @id @default(uuid())
  description String
  isDone      Boolean @default(false)

  user   User   @relation(fields: [userId], references: [id])
  userId String
}
