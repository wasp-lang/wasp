{
  "name": "askTheDocuments",
  "type": "module",
  "workspaces": [
    ".wasp/out/*",
    ".wasp/out/sdk/wasp"
  ],
  "scripts": {
    "build": "wasp build",
    "dev": "wasp start",
    "env:pull": "npx dotenv-vault@latest pull development .env.server",
    "env:push": "npx dotenv-vault@latest push development .env.server",
    "preview": "wasp build start",
    "test": "npm run test:e2e",
    "test:e2e": "npm run test:e2e:install-deps && DEBUG=pw:webserver playwright test --config e2e-tests/",
    "test:e2e:install-deps": "playwright install ${WASP_PLAYWRIGHT_INSTALL_FLAGS---with-deps}",
    "wasp": "wasp"
  },
  "dependencies": {
    "@heroui/react": "^2.8.7",
    "@tanstack/react-query": "~4.42.0",
    "@wasp/wasp": "file:../../waspc/.dev-packages/wasp-wasp-0.27.0.tgz",
    "cheerio": "1.0.0-rc.12",
    "framer-motion": "^12.23.26",
    "ky": "^2.0.0-0",
    "node-html-markdown": "1.3.0",
    "openai": "^6.27.0",
    "pgvector": "0.1.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.45.4",
    "react-markdown": "^10.1.0",
    "react-router": "^8.0.1",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@wasp/wasp-app-runner": "^0.0.19",
    "prisma": "6.19.3",
    "typescript": "6.0.3",
    "vite": "^8.1.0"
  },
  "overrides": {
    "@wasp/cli": "file:../../waspc/.dev-packages/wasp-cli-0.27.0.tgz",
    "@wasp/deploy": "file:../../waspc/.dev-packages/wasp-deploy-0.27.0.tgz",
    "@wasp/spec": "file:../../waspc/.dev-packages/wasp-spec-0.27.0.tgz",
    "@wasp/studio": "file:../../waspc/.dev-packages/wasp-studio-0.27.0.tgz"
  },
  "//": "TODO: This example depends on Wasp through `file:` tarballs, so it runs against the unreleased Wasp in this repo. Run `mise run build:dev-packages` before installing, see tasks/build/dev-packages.ts. The release-examples-deploy workflow switches to the released version. Once Wasp apps can use pnpm, the examples join the repo's pnpm workspace and depend on a plain version, see #4824."
}
