    "react-router": "^8.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@wasp/wasp-app-runner": "^0.0.19",
    "prisma": "6.19.3",
    "typescript": "6.0.3",
    "vite": "^8.1.0"
  },
  "overrides": {
    "@wasp/cli": "file:../../waspc/.dev-packages/wasp-cli-0.27.0.tgz",
