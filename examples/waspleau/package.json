{
  "name": "waspleau",
  "type": "module",
  "workspaces": [
    ".wasp/out/*",
    ".wasp/out/sdk/wasp"
  ],
  "scripts": {
    "test": "npm run test:e2e",
    "test:e2e": "npm run test:e2e:install-deps && DEBUG=pw:webserver playwright test --config e2e-tests/",
    "test:e2e:install-deps": "playwright install ${WASP_PLAYWRIGHT_INSTALL_FLAGS---with-deps}"
  },
  "dependencies": {
    "ky": "^2.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^8.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/devtools": "^0.8.2",
    "@wasp/spec": "file:.wasp/spec",
    "@wasp/wasp-app-runner": "^0.0.19",
    "prisma": "6.19.3",
    "typescript": "6.0.3",
    "vite": "^8.3.5"
  }
}
