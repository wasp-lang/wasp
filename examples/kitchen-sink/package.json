{
  "name": "kitchen-sink",
  "type": "module",
  "workspaces": [
    ".wasp/out/*",
    ".wasp/out/sdk/wasp"
  ],
  "scripts": {
    "env:pull": "npx dotenv-vault@latest pull development .env.server",
    "env:push": "npx dotenv-vault@latest push development .env.server",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "npm run test:e2e:install-deps && DEBUG=pw:webserver playwright test --config e2e-tests/",
    "test:e2e:install-deps": "playwright install ${WASP_PLAYWRIGHT_INSTALL_FLAGS---with-deps}",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "~4.42.0",
    "chai": "^5.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "~5.1.0",
    "ky": "^2.0.0",
    "linebyline": "^1.3.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.45.4",
    "react-router": "^8.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "uuid": "^9.0.1",
    "wait-port": "^1.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chai": "^5.2.2",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^9.0.8",
    "@vitejs/devtools": "^0.8.2",
    "@wasp/spec": "file:.wasp/spec",
    "@wasp/wasp-app-runner": "^0.0.19",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "prisma": "6.19.3",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.4"
  }
}
