{
  "name": "kitchen-sink",
  "type": "module",
  "scripts": {
    "build": "wasp build",
    "dev": "wasp start",
    "env:pull": "npx dotenv-vault@latest pull development .env.server",
    "env:push": "npx dotenv-vault@latest push development .env.server",
    "preview": "wasp build start",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:e2e": "pnpm run test:e2e:install-deps && DEBUG=pw:webserver playwright test --config e2e-tests/",
    "test:e2e:install-deps": "playwright install ${WASP_PLAYWRIGHT_INSTALL_FLAGS---with-deps}",
    "test:unit": "vitest run",
    "wasp": "wasp"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@socket.io/component-emitter": "^4.0.0",
    "@tanstack/react-query": "~4.42.0",
    "@wasp/wasp": "workspace:*",
    "arctic": "^1.9.2",
    "chai": "^5.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "~5.1.0",
    "ky": "^2.0.0",
    "linebyline": "^1.3.0",
    "lucia": "^3.2.2",
    "nodemailer": "^8.0.11",
    "pg-boss": "^8.4.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.45.4",
    "react-router": "^8.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "uuid": "^9.0.1",
    "wait-port": "^1.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chai": "^5.2.2",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^9.0.8",
    "@wasp/wasp-app-runner": "^0.0.19",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "prisma": "6.19.3",
    "typescript": "6.0.3",
    "vite": "^8.1.0",
    "vitest": "^5.0.4"
  }
}
